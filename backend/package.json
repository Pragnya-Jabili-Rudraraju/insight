{
  "name": "insight-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Insight modular-monolith backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand test/mongodb.integration.test.js",
    "test:watch": "jest --watch",
    "lint": "eslint src test evaluation",
    "evaluate": "node evaluation/run-evaluation.js"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "connect-mongo": "^6.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jest": "^30.1.0",
    "supertest": "^7.1.4"
  }
}
